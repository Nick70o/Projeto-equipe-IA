# Caminho do arquivo do banco SQLite (relativo à pasta backend/)
DATABASE_URL=sqlite:///./farmacia.db

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Dias considerados "vence em breve" para alertas no PDV (padrão usado no design-spec: 15 dias)
DIAS_ALERTA_VALIDADE=15

# --- Integração Pix via Mercado Pago (opcional) ---
# Token de acesso (Access Token) da sua aplicação no Mercado Pago.
# Como obter um token de TESTE (sandbox):
#   1. Crie/acesse uma conta em https://www.mercadopago.com.br/developers
#   2. Vá em "Suas integrações" > crie uma aplicação
#   3. Em "Credenciais de teste", copie o "Access Token" de teste (começa com TEST-)
#   4. Use contas de comprador/vendedor de teste para simular pagamentos Pix
# NUNCA commite o token real. Este arquivo é só um exemplo — copie para .env.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Base da API do Mercado Pago (normalmente não precisa alterar)
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
